# OpenAI API key (https://platform.openai.com/api-keys)
OPENAI_API_KEY=sk-여기에_본인_키를_붙여넣으세요

# 선택 설정 (그대로 두셔도 됩니다)
PORT=3000
CHAT_MODEL=gpt-4o
TTS_MODEL=gpt-4o-mini-tts
TTS_VOICE=nova
VOICE_PITCH=1.16
STT_MODEL=whisper-1

# 외부(인터넷)에 열 때는 반드시 설정하세요. 이 암호를 아는 사람만 접속할 수 있습니다.
ACCESS_CODE=

# ── 회상 대화 저장소 ──────────────────────────────────────────────
# 어르신의 사진과 생애 이야기가 저장될 폴더.
# 주의: Render 무료 플랜은 재배포하거나 서버가 잠들었다 깨면 디스크가 지워진다.
#       운영할 때는 영구 디스크 경로를 넣거나 데이터베이스로 바꿔야 한다.
DATA_DIR=

# 대화 원문을 남길지 (false 로 두면 내용은 지우고 지표에 필요한 것만 남긴다)
KEEP_TRANSCRIPT=true

# 어르신이 올리신 사진을 모델에게도 보여 줄지.
# 켜 두면 "바닷가에 계시네요" 처럼 사진을 보고 이야기를 엽니다.
# 사진을 보고 사람이 누구인지 언제인지 짐작하는 것은 프롬프트에서 막아 두었습니다.
PHOTO_VISION=true

# 사진을 얼마나 자세히 볼지. low 면 512 화소로 줄여 보므로 값싸고 빠릅니다.
# (low | high | auto)
VISION_DETAIL=low
