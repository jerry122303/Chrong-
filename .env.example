# OpenAI API key (https://platform.openai.com/api-keys)
OPENAI_API_KEY=sk-여기에_본인_키를_붙여넣으세요

# 선택 설정 (그대로 두셔도 됩니다)
PORT=3000
CHAT_MODEL=gpt-4o
TTS_MODEL=gpt-4o-mini-tts
TTS_VOICE=nova
VOICE_PITCH=1.16
STT_MODEL=whisper-1

# 외부(인터넷)에 열 때는 반드시 설정하세요. 이 암호를 아는 사람만 접속할 수 있습니다.
ACCESS_CODE=

# ── 회상 대화 저장소 ──────────────────────────────────────────────
# 어르신의 사진과 생애 이야기가 저장될 폴더.
# 주의: Render 무료 플랜은 재배포하거나 서버가 잠들었다 깨면 디스크가 지워진다.
#       운영할 때는 영구 디스크 경로를 넣거나 데이터베이스로 바꿔야 한다.
DATA_DIR=

# 대화 원문을 남길지 (false 로 두면 내용은 지우고 지표에 필요한 것만 남긴다)
KEEP_TRANSCRIPT=true

# 어르신이 올리신 사진을 모델에게도 보여 줄지.
# 켜 두면 "바닷가에 계시네요" 처럼 사진을 보고 이야기를 엽니다.
# 사진을 보고 사람이 누구인지 언제인지 짐작하는 것은 프롬프트에서 막아 두었습니다.
PHOTO_VISION=true

# 사진을 얼마나 자세히 볼지. low 면 512 화소로 줄여 보므로 값싸고 빠릅니다.
# (low | high | auto)
VISION_DETAIL=low

# 사진을 올릴 때 모델이 한 번 살펴 추천 점수에 씁니다 (사람 수 · 사물 · 장소 · 활동 · 시기).
# 비워 두면 PHOTO_VISION 을 따릅니다. 사진을 모델에게 보내지 않기로 했다면 이것도 꺼집니다.
PHOTO_ANALYSIS=

# 살펴볼 때 얼마나 자세히 볼지. 사람 수를 세야 해서 high 가 기본입니다. (low | high | auto)
ANALYSIS_DETAIL=high

# ── 사진에 남은 위치를 장소 이름으로 ──────────────────────────────
# 사진에 GPS 가 남아 있으면 "제주특별자치도 제주시" 처럼 바꿔 회상 단서로 씁니다.
# 바깥에 물을 때는 소수 셋째 자리(약 110미터)까지만 보내고 이름만 남깁니다.
# false 로 두면 좌표가 서버 밖으로 나가지 않습니다 (장소 이름은 보호자가 직접 적으면 됩니다).
GEOCODE=true

# 장소 이름을 물어볼 곳. 비워 두면 OpenStreetMap 의 무료 서비스를 씁니다.
GEOCODE_URL=
